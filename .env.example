# Base URL for WST backend API requests (Final v1 contract).
#
# Option A — hosted test backend (no local backend needed):
VITE_API_BASE_URL=https://wst-backend-brg8e7dmawf0gne0.switzerlandnorth-01.azurewebsites.net/api/v1
#
# Option B — local backend via the Vite dev-server proxy (avoids CORS setup):
# VITE_API_BASE_URL=/api/v1
# and start dev with WST_API_PROXY_TARGET=http://localhost:3000
# (vite.config.ts forwards /api to that target).
#
# Put machine-specific values in .env.local (git-ignored), never passwords.

# Explicit opt-out: set to "true" to force offline demo mode with labeled
# local data (never a fake success).
VITE_API_DISABLED=false
