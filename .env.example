# Base URL for WST backend API requests.
#
# Local development default (contract servers[0]): the frontend calls the
# backend directly at http://localhost:3000/api/v1. Alternatively, leave
# this as "/api/v1" to route through the Vite dev-server proxy defined in
# vite.config.ts (forwards /api to http://localhost:3000, no CORS setup).
#
# Production: set to the fully-qualified API base URL of the deployed
# backend, for example https://wst.example.edu/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Explicit opt-out: set to "true" to force offline demo mode with labeled
# local data (never a fake success).
VITE_API_DISABLED=false
